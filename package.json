{
  "private": true,
  "scripts": {
    "prepare": "husky",
    "prebuild": "rm -rf dist",
    "build": "NODE_NO_WARNINGS=1 parcel build --config @parcel/config-webextension",
    "watch": "NODE_NO_WARNINGS=1 parcel watch --no-hmr --config @parcel/config-webextension",
    "check": "run-p check:*",
    "check:typescript": "tsc --noEmit",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "run-p fix:*",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --write .",
    "test": "run-p check:* build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "webext-options-sync": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@parcel/config-webextension": "^2.16.4",
    "@parcel/resolver-default": "^2.16.4",
    "@playwright/test": "1.60.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "class-variance-authority": "^0.7.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "npm-run-all2": "^9.0.1",
    "parcel": "^2.16.4",
    "postcss": "^8.5.15",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "process": "^0.11.10",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "webextension-polyfill": "^0.12.0"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "targets": {
    "default": {
      "source": "src/manifest.json",
      "distDir": "./dist"
    }
  },
  "webExt": {
    "sourceDir": "dist",
    "run": {
      "startUrl": [
        "https://chatgpt.com",
        "https://claude.ai",
        "https://aistudio.google.com"
      ]
    }
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {}
    }
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  }
}
